// Read-only USERCODE inspection. IR 0x07 is USERCODE in Anlogic's EF2L45 BSDL.
TRST OFF;
ENDIR IDLE;
ENDDR IDLE;
HIR 0;
HDR 0;
TIR 0;
TDR 0;
FREQUENCY 1E6 HZ;
STATE RESET;
STATE IDLE;
RUNTEST 16 TCK;
SIR 8 TDI (06);
SDR 32 TDI (00000000) TDO (03004C37) MASK (FFFFFFFF);
SIR 8 TDI (07);
SDR 32 TDI (00000000);
SIR 8 TDI (FF);
RUNTEST 16 TCK;
