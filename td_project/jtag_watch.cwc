<chipwatcher project_name="demo14_vexriscv_stage1" bit_file="demo14_vexriscv_stage1_Runs/phy_1/demo14_vexriscv_stage1.bit" bid_file="demo14_vexriscv_stage1_Runs/phy_1/demo14_vexriscv_stage1_inst.bid" chip_name="EF2L45LG144B">
<!-- HMAC is: 334c278a3761d60ccf5e4802c263db5953c7df17870609a81592b8fd88ae8817 -->
	<instance name="auto_chipwatcher_0" id="0" enabled="yes">
		<clock clk_name="cpu0/clk" polarity="posedge"/>
		<config bram_name="auto_chipwatcher_0_logicbram" sample_depth="128"/>
		<signal_vec>
			<data_nets>
				<net name="cfg_jscanen[0]"/>
				<net name="cfg_jscanen[1]"/>
				<net name="cfg_jshift"/>
				<net name="cfg_jupdate"/>
			</data_nets>
			<watcher_nodes>
				<bus name="cfg_jscanen" radix="bin" state="collapse" op="dont_care" type="comb">
					<net name="cfg_jscanen[1]" type="comb" trigger="disable"/>
					<net name="cfg_jscanen[0]" type="comb" trigger="disable"/>
				</bus>
				<net name="cfg_jshift" op="equal" type="comb" trigger="disable"/>
				<net name="cfg_jupdate" op="equal" type="comb" trigger="disable"/>
			</watcher_nodes>
		</signal_vec>
		<trigger name="auto_chipwatcher_0_trigger" position="pre">
			<condition level="1" enabled="yes" type="basic_and">
				cfg_jscanen[0] == low && cfg_jscanen[1] == low && cfg_jshift == any && cfg_jupdate == any
			</condition>
			<log>
			</log>
		</trigger>
	</instance>
</chipwatcher>
