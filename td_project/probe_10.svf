// EF2 stage-1 loader; use only after configuring its matching bitstream.
TRST OFF;
ENDIR IDLE;
ENDDR IDLE;
HIR 0;
HDR 0;
TIR 0;
TDR 0;
FREQUENCY 1E6 HZ;
STATE RESET;
STATE IDLE;
RUNTEST 32 TCK;
SIR 8 TDI (06);
SDR 32 TDI (00000000) TDO (03004C37) MASK (FFFFFFFF);
SIR 8 TDI (10);
RUNTEST 32 TCK;
SDR 69 TDI (000000000000000000) TDO (094A8828E000000000) MASK (1FFFFFFFE000000000);
RUNTEST 32 TCK;
SIR 8 TDI (FF);
RUNTEST 32 TCK;
