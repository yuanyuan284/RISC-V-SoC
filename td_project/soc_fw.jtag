# JTAG loader text format for jtag_wb_loader.v
# SHIFT carries 69 TDI bits LSB-first in SHIFT-DR; COMMIT means UPDATE-DR.

# hold CPU reset
SHIFT 111110011111111111111111111111111111101000000000000000000000000000000
COMMIT
# write 0x80000000 = 0x400012b7
SHIFT 111110000000000000000000000000000000111101101010010000000000000000010
COMMIT
# write 0x80000004 = 0x0d800313
SHIFT 111110010000000000000000000000000000111001000110000000000000110110000
COMMIT
# write 0x80000008 = 0x0062a023
SHIFT 111110001000000000000000000000000000111000100000001010100011000000000
COMMIT
# write 0x8000000c = 0x400012b7
SHIFT 111110011000000000000000000000000000111101101010010000000000000000010
COMMIT
# write 0x80000010 = 0x04800313
SHIFT 111110000100000000000000000000000000111001000110000000000000100100000
COMMIT
# write 0x80000014 = 0x0462a623
SHIFT 111110010100000000000000000000000000111000100011001010100011000100000
COMMIT
# write 0x80000018 = 0x400012b7
SHIFT 111110001100000000000000000000000000111101101010010000000000000000010
COMMIT
# write 0x8000001c = 0x06500313
SHIFT 111110011100000000000000000000000000111001000110000000000101001100000
COMMIT
# write 0x80000020 = 0x0462a623
SHIFT 111110000010000000000000000000000000111000100011001010100011000100000
COMMIT
# write 0x80000024 = 0x400012b7
SHIFT 111110010010000000000000000000000000111101101010010000000000000000010
COMMIT
# write 0x80000028 = 0x06c00313
SHIFT 111110001010000000000000000000000000111001000110000000000001101100000
COMMIT
# write 0x8000002c = 0x0462a623
SHIFT 111110011010000000000000000000000000111000100011001010100011000100000
COMMIT
# write 0x80000030 = 0x400012b7
SHIFT 111110000110000000000000000000000000111101101010010000000000000000010
COMMIT
# write 0x80000034 = 0x06c00313
SHIFT 111110010110000000000000000000000000111001000110000000000001101100000
COMMIT
# write 0x80000038 = 0x0462a623
SHIFT 111110001110000000000000000000000000111000100011001010100011000100000
COMMIT
# write 0x8000003c = 0x400012b7
SHIFT 111110011110000000000000000000000000111101101010010000000000000000010
COMMIT
# write 0x80000040 = 0x06f00313
SHIFT 111110000001000000000000000000000000111001000110000000000111101100000
COMMIT
# write 0x80000044 = 0x0462a623
SHIFT 111110010001000000000000000000000000111000100011001010100011000100000
COMMIT
# write 0x80000048 = 0x400012b7
SHIFT 111110001001000000000000000000000000111101101010010000000000000000010
COMMIT
# write 0x8000004c = 0x02000313
SHIFT 111110011001000000000000000000000000111001000110000000000000001000000
COMMIT
