SHIFT 111110001010100000000000000000000000111101101010010000000000000000010
COMMIT
# write 0x800000ac = 0x00d00313
SHIFT 111110011010100000000000000000000000111001000110000000000101100000000
COMMIT
# write 0x800000b0 = 0x0462a623
SHIFT 111110000110100000000000000000000000111000100011001010100011000100000
COMMIT
# write 0x800000b4 = 0x400012b7
SHIFT 111110010110100000000000000000000000111101101010010000000000000000010
COMMIT
# write 0x800000b8 = 0x00a00313
SHIFT 111110001110100000000000000000000000111001000110000000000010100000000
COMMIT
# write 0x800000bc = 0x0462a623
SHIFT 111110011110100000000000000000000000111000100011001010100011000100000
COMMIT
# write 0x800000c0 = 0x0000006f
SHIFT 111110000001100000000000000000000000111110110000000000000000000000000
COMMIT
# select RAM reset vector while CPU remains reset
SHIFT 111110011111111111111111111111111111111000000000000000000000000000000
COMMIT
# release CPU reset and boot from RAM
SHIFT 111110011111111111111111111111111111110000000000000000000000000000000
COMMIT
