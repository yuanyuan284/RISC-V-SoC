// Read-only check against the USERCODE observed on this board on 2026-10-11.
// The value is not the stage2_uart.bit bitgen USERCODE; do not infer image identity.
TRST OFF;
ENDIR IDLE;
ENDDR IDLE;
HIR 0;
HDR 0;
TIR 0;
TDR 0;
FREQUENCY 1E6 HZ;
STATE RESET;
STATE IDLE;
RUNTEST 16 TCK;
SIR 8 TDI (06);
SDR 32 TDI (00000000) TDO (03004C37) MASK (FFFFFFFF);
SIR 8 TDI (07);
SDR 32 TDI (00000000) TDO (00190000) MASK (FFFFFFFF);
SIR 8 TDI (FF);
RUNTEST 16 TCK;
